generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogArticleFormat {
  SIMPLE
  SUGGESTION
  TOP_10
  GUIDE
  DATA_ANALYSIS
  FACE_TO_FACE
  PORTRAIT
  RETROSPECTIVE
}

model TrendingTrack {
  id          String   @id @default(cuid())
  appleId     String
  type        String // "songs" or "albums"
  name        String
  artistName  String
  artistId    String?
  artistUrl   String?
  artworkUrl  String?
  url         String?
  releaseDate String?
  genreIds    String[]
  genreNames  String[]
  explicit    Boolean  @default(false)
  rank        Int
  countryCode String
  fetchedAt   DateTime @default(now())

  @@index([countryCode, type, fetchedAt])
  @@index([appleId])
  // La recherche du dernier relevé trie sur fetchedAt sans filtrer : l'index
  // composite ci-dessus ne peut pas la servir.
  @@index([fetchedAt])
  @@map("trending_tracks")
}

model BlogArticle {
  id           Int               @id @default(autoincrement())
  format       BlogArticleFormat @default(SIMPLE)
  appleId      String?
  type         String? // "songs" or "albums"
  title        String
  titleFr      String?
  titleEn      String?
  artistName   String
  artworkUrl   String?
  streamCount  BigInt?
  countryCount Int?
  weekOf       DateTime
  editorialFr  String            @db.Text
  editorialEn  String            @db.Text
  introFr      String?           @db.Text
  introEn      String?           @db.Text
  conclusionFr String?           @db.Text
  conclusionEn String?           @db.Text
  published    Boolean           @default(true)
  createdAt    DateTime          @default(now())
  items        BlogArticleItem[]

  @@map("blog_articles")
}

model BlogArticleItem {
  id             Int         @id @default(autoincrement())
  articleId      Int
  position       Int
  appleId        String?
  type           String?
  title          String
  artistName     String
  artworkUrl     String?
  streamCount    BigInt?
  countryCount   Int?
  sectionTitleFr String?
  sectionTitleEn String?
  sectionTextFr  String?     @db.Text
  sectionTextEn  String?     @db.Text
  article        BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([appleId])
  @@map("blog_article_items")
}
